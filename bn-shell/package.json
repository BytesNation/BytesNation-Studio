{
	"name": "bytesnation-studio-shell",
	"private": true,
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"description": "BytesNation Studio presentation shell for the VDO.Ninja engine. Builds into ../bn/.",
	"scripts": {
		"dev": "vite build --watch",
		"build": "tsc --noEmit && vite build && node scripts/check-compat.mjs",
		"typecheck": "tsc --noEmit",
		"inventory:params": "node scripts/inventory-params.mjs .. > ../docs/inventory/params.json",
		"test:parity": "playwright test"
	},
	"dependencies": {
		"@fontsource/geist-mono": "5.3.0",
		"@fontsource/inter-tight": "5.3.0",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-slot": "1.5.0",
		"@radix-ui/react-tooltip": "1.4.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.79.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwind-merge": "2.6.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.1",
		"@playwright/test": "1.65.1",
		"@types/node": "24.19.2",
		"@types/react": "19.3.1",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "5.2.0",
		"autoprefixer": "10.7.0",
		"postcss": "8.5.33",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3",
		"vite": "7.3.8"
	}
}
